{
  "meta": {
    "schema_version": "1.1.0",
    "awf_version": "4.0.2"
  },
  "project": {
    "name": "Text to Speech Internal",
    "type": "Fullstack Web App",
    "status": "Development"
  },
  "tech_stack": {
    "frontend": {
      "framework": "React + Vite",
      "styling": "CSS"
    },
    "backend": {
      "framework": "FastAPI",
      "language": "Python"
    },
    "database": {
      "type": "SQLite",
      "orm": "SQLAlchemy"
    },
    "deployment": {
      "process_manager": "PM2",
      "reverse_proxy": "Nginx"
    }
  },
  "database_schema": {
    "summary": "App lưu thông tin cấu hình, lịch sử tạo audio, thư viện giọng đọc và tiến trình batch",
    "tables": [
      {
        "name": "users",
        "columns": [
          "id",
          "email",
          "password_hash"
        ]
      },
      {
        "name": "settings",
        "columns": [
          "key",
          "value"
        ]
      },
      {
        "name": "saved_voices",
        "columns": [
          "id",
          "name",
          "voice_type",
          "seed"
        ]
      },
      {
        "name": "generated_audio",
        "columns": [
          "id",
          "file_name",
          "original_text"
        ]
      },
      {
        "name": "batch_jobs",
        "columns": [
          "id",
          "status",
          "total_files",
          "completed_files"
        ]
      },
      {
        "name": "file_tasks",
        "columns": [
          "id",
          "job_id",
          "file_name",
          "status"
        ]
      },
      {
        "name": "user_subscriptions",
        "columns": [
          "id",
          "user_id",
          "plan_id",
          "status",
          "chars_limit",
          "batch_files_limit",
          "audio_storage_limit",
          "concurrent_jobs",
          "started_at",
          "expires_at",
          "payment_ref"
        ]
      },
      {
        "name": "usage_logs",
        "columns": [
          "id",
          "user_id",
          "chars_used",
          "action",
          "created_at"
        ]
      }
    ],
    "relationships_explained": "Mỗi batch job có nhiều file tasks."
  },
  "api_endpoints": [
    {
      "path": "/health",
      "explained": "Kiểm tra trạng thái hoạt động của backend"
    },
    {
      "path": "/api/auth/login",
      "explained": "Đăng nhập"
    },
    {
      "path": "/api/tts/chunk",
      "explained": "Tạo từng đoạn audio ngắn"
    },
    {
      "path": "/api/tts/merge",
      "explained": "Ghép các đoạn audio thành file dài"
    },
    {
      "path": "/api/jobs",
      "explained": "Quản lý quá trình chuyển đổi hàng loạt"
    },
    {
      "path": "/api/jobs/active/progress",
      "explained": "Lấy tiến trình công việc đang chạy và thông tin thống kê worker khả dụng của người dùng"
    },
    {
      "path": "/system-stats",
      "explained": "Lấy thống kê hệ thống (CPU, RAM, DB) và chi tiết số lượng worker đang bận"
    },
    {
      "path": "/api/self-hosted/warmup",
      "explained": "Khởi động mô hình (warmup) và lưu thiết lập voice (voice, seed, speed) cá nhân của người dùng vào Database"
    },
    {
      "path": "/api/settings",
      "explained": "Đọc (GET) và ghi (POST) các cấu hình của hệ thống và người dùng"
    }
  ],
  "business_rules": [
    "Nếu văn bản > 150 ký tự, frontend tự động chia nhỏ và gọi /api/tts/chunk",
    "Nếu văn bản > 2000 ký tự bị từ chối ở API bảo vệ",
    "Thư mục session chứa các file tạm sẽ tự động bị xoá sau 60 phút",
    "Các file audio trong Library sẽ tự động bị xóa sau 30 ngày (TTL) bằng background job library_cleaner",
    "Hỗ trợ phân phối song song tối đa 20 luồng đồng thời tới server Self-hosted OmniVoice (Mac Mini M4)"
  ]
}